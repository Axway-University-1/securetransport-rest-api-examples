meta {
  name: 04.accounts_name_GET_fields_without_type - Get a field of one account type, without the type
  type: http
  seq: 14
}

get {
  url: https://{{server}}:{{port}}/api/v2.0/accounts/:name?fields=addressBookSettings
  body: none
  auth: inherit
}

params:path {
  name: example_user
}

params:query {
  fields: addressBookSettings
}

assert {
  res.status: eq 400
}

docs {
  The same without type=user: 400, 'Field addressBookSettings does not exist'. An error answered on purpose, to show it.

  The same call as Admin/API 2.0/bash/05.Accounts/04.accounts_name_GET.sh.
}
