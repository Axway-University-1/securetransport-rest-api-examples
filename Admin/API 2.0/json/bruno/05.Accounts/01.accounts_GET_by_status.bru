meta {
  name: 01.accounts_GET_by_status - Get accounts by status
  type: http
  seq: 3
}

get {
  url: https://{{server}}:{{port}}/api/v2.0/accounts?status=DISABLED&type=user&fields=name&limit=5
  body: none
  auth: inherit
}

params:query {
  status: DISABLED
  type: user
  fields: name
  limit: 5
}

assert {
  res.status: eq 200
}

docs {
  Lists the disabled user accounts. The status is one of ACTIVE, DISABLED, LOCKED, PENDING, REJECTED. Changes nothing.

  The same call as Admin/API 2.0/bash/05.Accounts/01.accounts_GET.sh.
}
