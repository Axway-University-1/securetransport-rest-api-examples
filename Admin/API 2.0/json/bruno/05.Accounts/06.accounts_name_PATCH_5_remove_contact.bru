meta {
  name: 06.accounts_name_PATCH_5_remove_contact - Patch: remove an array element
  type: http
  seq: 21
}

patch {
  url: https://{{server}}:{{port}}/api/v2.0/accounts/:name
  body: json
  auth: inherit
}

params:path {
  name: example_user
}

headers {
  Content-Type: application/json
}

body:json {
  [
    {
      "op": "remove",
      "path": "/addressBookSettings/contacts/0"
    }
  ]
}

assert {
  res.status: eq 204
}

docs {
  Takes the contact out again, by its position (0, the first). Answers 204.

  The same call as Admin/API 2.0/bash/05.Accounts/06.accounts_name_PATCH.sh.
}
