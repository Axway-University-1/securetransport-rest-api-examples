meta {
  name: 06.accounts_name_PATCH_4_add_contact - Patch: add to an array
  type: http
  seq: 20
}

patch {
  url: https://{{server}}:{{port}}/api/v2.0/accounts/:name
  body: json
  auth: inherit
}

params:path {
  name: example_user
}

headers {
  Content-Type: application/json
}

body:json {
  [
    {
      "op": "add",
      "path": "/addressBookSettings/contacts/-",
      "value": {
        "fullName": "Jane Doe",
        "primaryEmail": "jane.doe@abc.com"
      }
    }
  ]
}

assert {
  res.status: eq 204
}

docs {
  Appends a contact to the address book: the path ends in a hyphen, which adds to the end of an array, empty or not. A number as the index only works when the element 0 is there. Answers 204.

  The same call as Admin/API 2.0/bash/05.Accounts/06.accounts_name_PATCH.sh.
}
