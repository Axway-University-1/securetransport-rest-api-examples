meta {
  name: 02.accounts_POST_user_duplicate - Create a user account that exists
  type: http
  seq: 8
}

post {
  url: https://{{server}}:{{port}}/api/v2.0/accounts
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "example_user",
    "type": "user",
    "homeFolder": "/home/example_user",
    "uid": "41733",
    "gid": "41733",
    "user": {
      "name": "example_user",
      "passwordCredentials": {
        "password": "{{accountPassword}}"
      }
    }
  }
}

assert {
  res.status: eq 409
}

docs {
  Sends the same body again: the answer is 409, 'The account name is not unique'. An error answered on purpose, to show it. Needs 02.accounts_POST_user to have run.

  The same call as Admin/API 2.0/bash/05.Accounts/02.accounts_POST.sh.
}
