meta {
  name: 02.accounts_POST_service - Create a service account
  type: http
  seq: 5
}

post {
  url: https://{{server}}:{{port}}/api/v2.0/accounts
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "example_service",
    "type": "service",
    "homeFolder": "/home/example_service",
    "uid": "41733",
    "gid": "41733"
  }
}

assert {
  res.status: eq 201
}

docs {
  Creates the service account example_service. A service account has no user object, so no password.

  The same call as Admin/API 2.0/bash/05.Accounts/02.accounts_POST.sh.
}
