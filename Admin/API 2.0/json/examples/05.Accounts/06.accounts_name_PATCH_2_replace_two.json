{
  "name": "Patch: replace two fields",
  "bash": "05.Accounts/06.accounts_name_PATCH.sh",
  "description": "Two operations in one request: the policy back to default, and the collaboration flag true. Answers 204.",
  "method": "PATCH",
  "path": "/accounts/{name}",
  "pathParams": {
    "name": "example_user"
  },
  "body": [
    {
      "op": "replace",
      "path": "/addressBookSettings/policy",
      "value": "default"
    },
    {
      "op": "replace",
      "path": "/addressBookSettings/nonAddressBookCollaborationAllowed",
      "value": "true"
    }
  ],
  "expect": 204
}
