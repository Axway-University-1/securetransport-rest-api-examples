  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{user}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "05.Accounts",
      "item": [
        {
          "name": "01.accounts_GET - Get accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"answers 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Referer",
                "value": "THIS_IS_A_RANDOM_TEXT",
                "type": "text"
              }
            ],
            "url": {
              "raw": "https://{{server}}:{{port}}/api/v2.0/accounts?type=user&fields=name,homeFolder&limit=5",
              "protocol": "https",
              "host": [
                "{{server}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "v2.0",
                "accounts"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "user"
                },
                {
                  "key": "fields",
                  "value": "name,homeFolder"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Lists the user accounts, with only their name and home folder, five at a time. Changes nothing. The type is always in the answer, listed or not.\n\nThe same call as Admin/API 2.0/bash/05.Accounts/01.accounts_GET.sh."
          },
          "response": []
        },
