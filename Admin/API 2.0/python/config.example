#
# Configuration for the Admin API 2.0 python examples.
#
# Copy this file to 'config' in this same directory and fill in the values for
# your own environment. The 'config' file is excluded from git so that your
# credentials are never committed.
#
#   cp config.example config
#
# The scripts resolve this file relative to their own location, so they can be
# run from any working directory.
#
# These are the same four variable names the bash and bat examples use, in
# lower case. The scripts build the API URL and the base64 Authorization value
# from them, so there is nothing to encode by hand.
#

# The SecureTransport host, without the protocol or port
st_server="st.example.com"

# The admin port. 8444 for a non root install, 444 for a root install.
st_port="8444"

# An administrator account and its password, in plain text
st_user="apiadmin"
st_password="change_me"

#
# Optional. Only stGraceful.py uses this, for the edge server in a
# core plus edge deployment. It defaults to st_server when not set.
#
#st_edge_server="edge.example.com"

#
# Optional. Check the server's TLS certificate. By default the examples do not
# check it (a lab server usually has a self signed one), which also means they
# would talk to anything that answers on that address. For a server you do not
# fully control, give the file that holds its certificate authority (a PEM
# file), or say yes to check against the certificate authorities of this machine.
#
#st_ca_bundle="/path/to/ca-bundle.pem"
#st_verify="yes"

#
# Optional. Only stUpdateAllAccounts.py uses this: the combined private key and
# certificate (unencrypted, one PEM file) it logs in with. A relative path is
# read from the folder of this file. When it is not set the script looks for
# ST_API_client.pem next to itself.
#
#st_client_cert="ST_API_client.pem"

#
# Optional. Only stConfigScan.py uses this: where it writes and reads the
# baseline of the server's options (JSON). The command line wins over it. When
# it is not set the file is stConfig.baseline next to the script.
#
#st_config_baseline="/path/to/stConfig.baseline"
