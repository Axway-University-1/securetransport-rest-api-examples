# ==============================================================================
# .gitignore
# ==============================================================================
# Keeps the repository limited to the example scripts themselves. Everything
# below is either OS/editor clutter or output produced by running the examples,
# and is of no use to anyone who clones this project.
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating system clutter
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ------------------------------------------------------------------------------
# Editor and IDE files
# ------------------------------------------------------------------------------
# Claude Code local settings. The knowledge pack in .claude/skills and
# .claude/agents is shared, but these files are personal to each machine and
# record local permission grants, so they stay out of git.
.claude/settings.json
.claude/settings.local.json

# vi / vim swap files
*.swp
*.swo
.*.sw?

*~
*.bak
*.orig
.vscode/
.idea/

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ------------------------------------------------------------------------------
# Output produced by running the examples
# ------------------------------------------------------------------------------
# Session cookie jars written by the authentication scripts
cookie.jar
myCookie.jar
*.cookie.jar

# Log files written by the scripts
*.log

# Temporary API responses written by the bash and bat examples
tmp.json*
servers.json
daemons.json
app.json

# Files downloaded or generated by the EndUser file transfer examples
downloaded_files/
test.txt_*

# Output written by the python utils
convertedUserClasses.xml

# ------------------------------------------------------------------------------
# Test workspace
# ------------------------------------------------------------------------------
# The test harness, fixtures and checks under tests/ are shared. These two
# directories are not: tests/local is where you keep responses captured from a
# real server and anything else that must not reach the repository, and
# tests/output holds whatever a run produces. Neither is needed for the checks
# to pass. See tests/README.md.
tests/local/
tests/output/

# ------------------------------------------------------------------------------
# Credentials
# ------------------------------------------------------------------------------
# Each of these has a committed .example counterpart. Copy the example, fill in
# the values for your own environment, and your credentials stay out of git.
#
# The bash and bat examples read set_variables.local.sh / .bat, which override
# the placeholders in the committed set_variables.sh / .bat.
set_variables.local.sh
set_variables.local.bat
Features/**/settings.local.sh
Features/**/settings.local.bat
Features/**/state.local.sh
Features/**/state.local.bat

# The python examples read this config file
Admin/API 2.0/python/config

# ------------------------------------------------------------------------------
# Certificates and keys
# ------------------------------------------------------------------------------
# Never commit private keys. Keep the ones you use with the examples locally.
*.pem
*.crt
*.cer
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.pub
testsshkey
testsshkey.pub
