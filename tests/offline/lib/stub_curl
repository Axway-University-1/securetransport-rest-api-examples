#!/bin/bash
# tools/script_coverage.py asks which script made each call: the parent's command line is the script
if [ -n "${COVERAGE_LOG:-}" ]; then
    _p=$PPID
    for _i in 1 2 3; do   # past the wrappers around this stub, to the script that called curl
        _c=$(ps -o command= -p "${_p}" 2>/dev/null)
        case "${_c}" in *"/curl "*|*"/curl_stub "*|*"stub_curl"*) _p=$(ps -o ppid= -p "${_p}" 2>/dev/null | tr -d ' ') ;; *) break ;; esac
    done
    printf 'CALL %s\n' "${_c}" >> "${COVERAGE_LOG}"
fi
# ==============================================================================
# A stand-in for curl, used by the offline tests.
#
# It never sends anything. It reports what an example would have sent, so a test
# can check the URL and the request body. Put its directory first on PATH:
#
#   PATH="tests/lib:$PATH" ./some_example.sh
#
# Diagnostics go to stderr, so that an example which captures a response with
# "> tmp.json" gets a clean body and not this stub's own output.
#
# For an example that reads a response and sends it back, point
# STUB_CURL_GET_BODY at a file. Its contents are written to stdout for GET.
#
# STUB_CURL_POST_BODY does the same for POST, for an example that reads an id
# out of the response to its first call.
#
# -G turns -d/--data-urlencode into GET query parameters, the same as real curl
# (used by an example that builds a query with --data-urlencode so curl does the
# URL-encoding). The stub appends them to the URL it reports, unencoded, since
# the point here is to let a test read the parameter values back out.
#
# A request body may contain newlines and quotes, so it is emitted base64
# encoded on a single line. Decode it with:
#
#   sed -n 's/^PAYLOAD_B64: //p' out.txt | while read -r b; do echo "$b" | base64 -d; done
#
# -b/--cookie is echoed as COOKIE: file, and -c/--cookie-jar as COOKIE_JAR_WRITE: file,
# so a test can tell a call that sends a session from one that logs in again.
#
# -u/--user is echoed as BASIC_AUTH: user:pass, same as a -H header - this is
# how a script that logs in with the wrong (for example empty, from a variable
# that was never set) credentials gets caught: the call shape still looks right.
# ==============================================================================
url=""
has_referer=0
has_ctype=0
payload=""
method="GET"
header_file=""
output_file=""
write_out=""
use_g=0
query_params=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--data|--data-raw|--data-binary) payload="$2"; shift 2 ;;
    --data-urlencode)                   query_params+=("$2"); shift 2 ;;
    -G)                                 use_g=1; shift ;;
    -X|--request)                       method="$2"; shift 2 ;;
    -H|--header)                        echo "HEADER: $2" >&2; [[ "$2" == [Rr]eferer:* ]] && has_referer=1; [[ "$2" == [Cc]ontent-[Tt]ype:* ]] && has_ctype=1; shift 2 ;;
    -u|--user)                          echo "BASIC_AUTH: $2" >&2; shift 2 ;;
    -F|--form|--form-string)            echo "FORM: $2" >&2; shift 2 ;;
    -b|--cookie)                        echo "COOKIE: $2" >&2; shift 2 ;;
    -c|--cookie-jar)                    echo "COOKIE_JAR_WRITE: $2" >&2; shift 2 ;;
    -w|--write-out)                     write_out="$2"; shift 2 ;;
    -D|--dump-header)                   header_file="$2"; shift 2 ;;
    -o|--output)                        output_file="$2"; shift 2 ;;
    --head|-I)                          method="HEAD"; shift ;;
    https://*|http://*)                 url="$1"; shift ;;
    *)                                  shift ;;
  esac
done

# Every call to the server carries a Referer header (the CSRF protection of the 20230525 release asks for one, see st-api-gotchas):
# a call without one is an error here, so that a script that stops sending it fails every test that runs it.
# STUB_CURL_REQUIRE_REFERER=0 turns it off, for a test that is about a call with none.
if [[ "${STUB_CURL_REQUIRE_REFERER:-1}" != "0" && -n "${url}" && "${has_referer}" -eq 0 ]]; then
    echo "STUB_ERROR: the call to ${url} has no Referer header" >&2
    exit 22
fi

# A JSON body sent with no Content-Type is read by the server as a form and refused (415 or 400): a call like that is an error here too.
# STUB_CURL_REQUIRE_CONTENT_TYPE=0 turns it off.
if [[ "${STUB_CURL_REQUIRE_CONTENT_TYPE:-1}" != "0" && "${has_ctype}" -eq 0 && "${payload}" == [\{\[]* && "${method}" =~ ^(POST|PUT|PATCH)$ ]]; then
    echo "STUB_ERROR: the call to ${url} sends a JSON body with no Content-Type header" >&2
    exit 22
fi

if [[ "${use_g}" -eq 1 && "${#query_params[@]}" -gt 0 ]]; then
    sep="?"
    for p in "${query_params[@]}"; do
        url="${url}${sep}${p}"
        sep="&"
    done
fi

# An example that wants the response headers (-D file) gets a status line and,
# when STUB_CURL_LOCATION_ID is set, a Location header ending in that id.
# STUB_CURL_STATUS_FILES does so for a URL with /files/ in it (the End User API's folders and files).
# STUB_CURL_FILES_POST_SEQUENCE points at a file with one line per POST to a URL
# with /files/ in it: "STATUS" or "STATUS<tab>BODY_FILE". Each such POST takes the
# next line, the last repeating; it wins over STUB_CURL_STATUS_FILES, and the body
# file, when there is one, is the response body instead of STUB_CURL_POST_BODY.
# STUB_CURL_STATUS overrides the status, 201 by default; STUB_CURL_STATUS_DELETE
# and STUB_CURL_STATUS_GET do so for DELETE or GET only. STUB_CURL_CSRF adds a
# csrfToken header, as a login does. Every -H header is echoed as HEADER: ...
files_seq_status=""; files_seq_body=""
if [[ "${method}" == "POST" && "${url}" == */files/* && -n "${STUB_CURL_FILES_POST_SEQUENCE}" && -f "${STUB_CURL_FILES_POST_SEQUENCE}" ]]; then
    counter="${STUB_CURL_FILES_POST_SEQUENCE}.served"
    n=$(( $(cat "${counter}" 2>/dev/null || echo 0) + 1 ))
    total=$(grep -c '' "${STUB_CURL_FILES_POST_SEQUENCE}")
    [[ "${n}" -gt "${total}" ]] && n="${total}"
    echo "${n}" > "${counter}"
    IFS=$'\t' read -r files_seq_status files_seq_body < <(sed -n "${n}p" "${STUB_CURL_FILES_POST_SEQUENCE}")
fi
if [[ -n "${header_file}" ]]; then
    {
        status="${STUB_CURL_STATUS:-201}"
        [[ "${method}" == "DELETE" && -n "${STUB_CURL_STATUS_DELETE}" ]] && status="${STUB_CURL_STATUS_DELETE}"
        [[ "${method}" == "GET" && -n "${STUB_CURL_STATUS_GET}" ]] && status="${STUB_CURL_STATUS_GET}"
        [[ "${url}" == */files/* && -n "${STUB_CURL_STATUS_FILES}" ]] && status="${STUB_CURL_STATUS_FILES}"
        [[ -n "${files_seq_status}" ]] && status="${files_seq_status}"
        printf 'HTTP/1.1 %s Stub\r\n' "${status}"
        [[ -n "${STUB_CURL_LOCATION_ID}" ]] && printf 'Location: %s/%s\r\n' "${url%%\?*}" "${STUB_CURL_LOCATION_ID}"
        [[ -n "${STUB_CURL_CSRF}" ]] && printf 'csrfToken: %s\r\n' "${STUB_CURL_CSRF}"
        printf '\r\n'
    } > "${header_file}"
fi

echo "METHOD: ${method}" >&2
echo "URL: ${url}" >&2

if [[ -n "${payload}" ]]; then
    # A body read from a file, curl's -d @file form
    if [[ "${payload}" == @* ]]; then
        file="${payload#@}"
        if [[ -f "${file}" ]]; then
            payload="$(cat "${file}")"
            if [[ "${STUB_CURL_REQUIRE_CONTENT_TYPE:-1}" != "0" && "${has_ctype}" -eq 0 && "${payload}" == [\{\[]* && "${method}" =~ ^(POST|PUT|PATCH)$ ]]; then
                echo "STUB_ERROR: the call to ${url} sends a JSON body (a file) with no Content-Type header" >&2
                exit 22
            fi
        else
            echo "PAYLOAD_MISSING_FILE: ${file}" >&2
            exit 0
        fi
    fi
    echo "PAYLOAD_B64: $(printf '%s' "${payload}" | base64 | tr -d '\n')" >&2
fi

# Serve a canned body, so a GET, edit, PUT or POST example can run end to end.
# Like real curl, -o sends it to that file instead of standard output.
serve() {
    if [[ -n "${output_file}" ]]; then cat "$1" > "${output_file}"; else cat "$1"; fi
}
# STUB_CURL_GET_RULES points at a file of "TEXT<tab>BODY_FILE" lines, for an
# example whose GETs need different answers: the first line whose TEXT is in the
# URL picks the body. A URL no line matches falls back to STUB_CURL_GET_BODY.
get_body="${STUB_CURL_GET_BODY}"
if [[ "${method}" == "GET" && -n "${STUB_CURL_GET_RULES}" && -f "${STUB_CURL_GET_RULES}" ]]; then
    while IFS=$'\t' read -r text file; do
        if [[ -n "${text}" && "${url}" == *"${text}"* ]]; then
            get_body="${file}"
            break
        fi
    done < "${STUB_CURL_GET_RULES}"
fi
# STUB_CURL_GET_SEQUENCE points at a folder of 1.json, 2.json, ...: each GET is
# answered with the next one, the last one repeating. For an example that lists,
# acts and lists again, and expects the answer to have changed.
if [[ "${method}" == "GET" && -n "${STUB_CURL_GET_SEQUENCE}" && -d "${STUB_CURL_GET_SEQUENCE}" ]]; then
    counter="${STUB_CURL_GET_SEQUENCE}/.served"
    n=$(( $(cat "${counter}" 2>/dev/null || echo 0) + 1 ))
    [[ -f "${STUB_CURL_GET_SEQUENCE}/${n}.json" ]] || n=$(( n - 1 ))
    echo "${n}" > "${counter}"
    get_body="${STUB_CURL_GET_SEQUENCE}/${n}.json"
fi
if [[ "${method}" == "GET" && -n "${get_body}" && -f "${get_body}" ]]; then
    serve "${get_body}"
fi

if [[ -n "${files_seq_body}" && -f "${files_seq_body}" ]]; then
    serve "${files_seq_body}"
elif [[ "${method}" == "POST" && -n "${STUB_CURL_POST_BODY}" && -f "${STUB_CURL_POST_BODY}" ]]; then
    serve "${STUB_CURL_POST_BODY}"
fi

# Like real curl, the -w text comes after the response body.
#
# HEAD with -w "%{http_code}", as an existence check: print STUB_CURL_STATUS_HEAD, or
# else STUB_CURL_STATUS (200 when neither is set)
if [[ "${method}" == "HEAD" && "${write_out}" == *http_code* ]]; then
    printf '%s' "${STUB_CURL_STATUS_HEAD:-${STUB_CURL_STATUS:-200}}"
elif [[ -n "${STUB_CURL_PRINT_CODE}" && "${write_out}" == *http_code* ]]; then
    # Opt in: act on any -w format, as curl does after the response, so a script that
    # prints "HTTP <code>" shows the status STUB_CURL_STATUS gives (201 by default)
    code="${STUB_CURL_STATUS:-201}"
    [[ "${method}" == "GET" && -n "${STUB_CURL_STATUS_GET}" ]] && code="${STUB_CURL_STATUS_GET}"
    printf '%b' "${write_out//%\{http_code\}/${code}}"
fi


exit 0
